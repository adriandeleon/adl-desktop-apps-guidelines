---
// CHANGELOG.md (Keep a Changelog) rendered on the site: the current edition as "What's new" on the overview, and
// every edition on the Changelog page, each under its own anchor. The file stays the one source of what changed.
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import pkg from "../../package.json";
import text from "../../CHANGELOG.md?raw"; // bundled at build time, so the page needs no file at run time
import { parseEditions, isVersion } from "../lib/editions.mjs";
import { siteRoot } from "../lib/site.mjs";

interface Props {
  /** Only the edition package.json names (the overview's What's new); otherwise every edition. */
  latest?: boolean;
}
const { latest = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const root = siteRoot(pkg); // every released edition is served whole under root/<version>/

const processor = await createMarkdownProcessor();
/** The headline of each entry per group, for the overview's summary: the bold lead of a bullet, else its first sentence,
 *  as plain text. A group longer than MOST headlines ends with "and N more". */
const MOST = 6;
const plain = (md: string) => md.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/[`*_]/g, "").replace(/\.$/, "").trim();
const headlines = (body: string) => {
  const groups: { label: string; leads: string[] }[] = [];
  for (const line of body.split("\n")) {
    const h = line.match(/^### (.+)/);
    if (h) { groups.push({ label: h[1].trim(), leads: [] }); continue; }
    const b = line.match(/^- (?:\*\*(.+?)\*\*|([^.]+))/);
    if (b && groups.length) groups.at(-1)!.leads.push(plain(b[1] ?? b[2]));
  }
  return groups
    .filter((g) => g.leads.length)
    .map((g) => ({ ...g, more: Math.max(0, g.leads.length - MOST), leads: g.leads.slice(0, MOST) }));
};

const editions: { version: string; date?: string; html: string; groups: { label: string; leads: string[] }[] }[] = [];
for (const { version, date, body } of parseEditions(text)) {
  editions.push({ version, date, html: (await processor.render(body)).code, groups: headlines(body) });
}
const current = editions.find((e) => e.version === pkg.version) ?? editions.find((e) => e.date);
const shown = latest ? (current ? [current] : []) : editions;
const long = (d: string) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<div class:list={["editions", { news: latest }]}>
  {!latest && (
    <nav class="edition-index" aria-label="Editions">
      <span>Editions</span>
      <ul>
        {editions.map((e) => (
          <li>
            <a href={`#${e.version.toLowerCase()}`}>{e.version}</a>
            {e.version === current?.version && <span class="latest">latest</span>}
          </li>
        ))}
      </ul>
    </nav>
  )}
  {shown.map((e) =>
    latest ? (
      <section class="edition">
        <p class="edition-meta">
          Edition <strong>{e.version}</strong>{e.date && <> · <time datetime={e.date}>{long(e.date)}</time></>}
        </p>
        {e.groups.map((g) => (
          <p class="edition-summary">
            <strong>{g.label}</strong> {g.leads.join(" · ")}{g.more > 0 && ` and ${g.more} more`}
          </p>
        ))}
        <p class="edition-more">
          <a href={`${base}changelog/`}>Everything that changed, and every earlier edition</a>
        </p>
      </section>
    ) : (
      <section class="edition" id={e.version.toLowerCase()}>
        <h2>
          <a href={`#${e.version.toLowerCase()}`}>{e.version}</a>
          {e.date && <time datetime={e.date}>{long(e.date)}</time>}
          {isVersion(e.version) && e.date && (
            <a class="browse" href={`${root}${e.version}/`}>Read this edition</a>
          )}
        </h2>
        <Fragment set:html={e.html} />
      </section>
    )
  )}
</div>
