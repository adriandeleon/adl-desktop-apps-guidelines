---
// Starlight's site title followed by the edition: the switcher where the header has room, the version alone on a
// phone, where the switcher lives in the menu instead (MobileMenuFooter.astro).
import Default from "@astrojs/starlight/components/SiteTitle.astro";
import EditionSelect from "./EditionSelect.astro";
import pkg from "../../package.json";
import { siteRoot, editionOf, NEXT, APPENDIX } from "../lib/site.mjs";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const changelog = `${base}changelog/`;
const here = editionOf(base, siteRoot(pkg));
const next = here === NEXT;
const appendix = here === APPENDIX; // in no edition: no version and no switcher
---

<Default />
{
  appendix ? (
    <span class="edition-mini" title="Outside the editions, updated as the apps change">appendix</span>
  ) : (
    <>
      <a class="edition-mini md:sl-hidden print:hidden" href={changelog} title={next ? "Unreleased changes, not an edition yet" : "This edition of the guidelines"}>{next ? NEXT : pkg.version}</a>
      <EditionSelect class="sl-hidden md:sl-flex" />
    </>
  )
}

<style>
  .edition-mini {
    margin-inline-start: 0.1rem; font-family: var(--sl-font-mono); font-size: var(--sl-text-xs); font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-3); text-decoration: none; white-space: nowrap; align-self: center;
  }
  pauta-edition-select { margin-inline-start: 0.25rem; align-self: center; }
</style>
