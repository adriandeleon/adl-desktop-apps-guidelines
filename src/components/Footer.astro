---
// Starlight's footer plus the edition: version and date from package.json, the Changelog, and this page's address in
// the latest edition or at its permanent, numbered one. In next/ it names the edition the batch follows instead.
import Default from "@astrojs/starlight/components/Footer.astro";
import pkg from "../../package.json";
import { siteRoot, editionOf, NEXT } from "../lib/site.mjs";

const date = new Date(`${pkg.guidelines.date}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
});
const root = siteRoot(pkg);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const here = editionOf(base, root);
const rest = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : "";
const changelog = `${base}changelog/`;
const next = here === NEXT;
const other = here === "latest"
  ? { href: `${root}${pkg.version}/${rest}`, text: `Permanent link to this page in ${pkg.version}` }
  : { href: `${root}latest/${rest}`, text: "This page in the latest edition" };
---

<Default><slot /></Default>
<p class="edition">
  {
    next ? (
      <>Pauta <strong>Next</strong> · unreleased changes after {pkg.version} · </>
    ) : (
      <>Pauta <strong>{pkg.version}</strong> · <time datetime={pkg.guidelines.date}>{date}</time> · </>
    )
  }<a href={changelog}>Changelog</a> · <a href={other.href} rel="alternate">{other.text}</a>
</p>

<style>
  .edition { margin-top: 1rem; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; }
  .edition a { color: inherit; }
</style>
